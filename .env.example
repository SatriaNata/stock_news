# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT (SALIN KE .env UNTUK PENGGUNAAN LOKAL)
# ==============================================================================
# PERINGATAN: Jangan pernah menuliskan kunci asli di file ini atau membagikannya!
# ==============================================================================

# 1. Kunci API Gemini (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# 2. Pengaturan Telegram Bot (Dapatkan dari @BotFather di Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 3. ID Chat Telegram Penerima (Gunakan script scripts/get_telegram_chat_id.py)
TELEGRAM_CHAT_ID=123456789

# 4. URL Dashboard GitHub Pages Anda (Contoh: https://username.github.io/nama-repo/)
DASHBOARD_URL=https://username.github.io/stocks-news/
